<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="cover" />
    <ImageView android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="bottom|start" android:layout_margin="6dp" android:padding="8dp" android:contentDescription="play" />
    <ImageView android:id="@+id/w_fav" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="top|end" android:layout_margin="4dp" android:padding="8dp" android:contentDescription="fav" />
</FrameLayout>
