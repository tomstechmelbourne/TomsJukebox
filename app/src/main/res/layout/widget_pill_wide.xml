<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="bg" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:gravity="center">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:id="@+id/w_art" android:layout_width="46dp" android:layout_height="46dp" android:padding="0dp" android:scaleType="fitCenter" android:contentDescription="w_art" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:gravity="center_horizontal">
<TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:shadowColor="#66000000" android:shadowRadius="2" android:gravity="center"/><TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8DCD0" android:textSize="11sp"  android:singleLine="true" android:ellipsize="end" android:shadowColor="#66000000" android:shadowRadius="2" android:gravity="center"/></LinearLayout>
<ImageView android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="6dp" android:scaleType="fitCenter" android:contentDescription="w_play" /><ImageView android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp" android:padding="7dp" android:scaleType="fitCenter" android:contentDescription="w_next" /></LinearLayout>
    </LinearLayout>
</FrameLayout>
