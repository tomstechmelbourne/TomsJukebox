<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_pill_bg" android:padding="6dp">
    <ImageView android:id="@+id/w_art" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:src="@drawable/app_logo" android:contentDescription="Cover" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:singleLine="true" android:ellipsize="end" android:text="Tom\'s Jukebox" />
            <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E8DCD0" android:textSize="11sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
        <ImageView android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/g_prev" android:contentDescription="Previous" />
        <ImageView android:id="@+id/w_play" android:layout_width="48dp" android:layout_height="48dp" android:padding="8dp" android:src="@drawable/g_play" android:contentDescription="Play" />
        <ImageView android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/g_next" android:contentDescription="Next" />
</LinearLayout>
